/* ---------------------------- MPU6050 driver ---------------------------- */
static bool mpuWrite(uint8_t reg, uint8_t val) {
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(reg); Wire.write(val);
  return Wire.endTransmission() == 0;
}
static bool mpuInit() {
  Wire.beginTransmission(MPU_ADDR);
  if (Wire.endTransmission() != 0) return false;
  mpuWrite(0x6B, 0x80); delay(120);
  mpuWrite(0x6B, 0x01); delay(60);
  mpuWrite(0x1A, 0x04);
  mpuWrite(0x19, 9);
  mpuWrite(0x1B, 0x00);
  mpuWrite(0x1C, 0x00);
  return true;
}
static bool mpuRead(float a[3], float g[3], float *tempC) {
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(0x3B);
  if (Wire.endTransmission(false) != 0) return false;
  if (Wire.requestFrom((uint8_t)MPU_ADDR, (uint8_t)14) != 14) return false;
  int16_t r[7];
  for (int i = 0; i < 7; i++) r[i] = (int16_t)((Wire.read() << 8) | Wire.read());
  a[0] = r[0] / 16384.0f; a[1] = r[1] / 16384.0f; a[2] = r[2] / 16384.0f;
  *tempC = r[3] / 340.0f + 36.53f;
  g[0] = r[4] / 131.0f;   g[1] = r[5] / 131.0f;   g[2] = r[6] / 131.0f;
  return true;
}

/* ------------------------------ filters --------------------------------- */
struct Median5 {
  float b[5]; uint8_t n = 0, i = 0;
  float push(float v) {
    b[i] = v; i = (i + 1) % 5; if (n < 5) n++;
    float t[5];
    for (uint8_t k = 0; k < n; k++) t[k] = b[k];
    for (uint8_t a = 1; a < n; a++) {
      float x = t[a]; int8_t j = a - 1;
      while (j >= 0 && t[j] > x) { t[j + 1] = t[j]; j--; }
      t[j + 1] = x;
    }
    return t[n / 2];
  }
};
Median5 medA[3];

static void norm3(float v[3]) {
  float m = sqrtf(v[0]*v[0] + v[1]*v[1] + v[2]*v[2]);
  if (m > 1e-6f) { v[0] /= m; v[1] /= m; v[2] /= m; }
}
static float dot3(const float a[3], const float b[3]) { return a[0]*b[0] + a[1]*b[1] + a[2]*b[2]; }
static void cross3(const float a[3], const float b[3], float o[3]) {
  o[0] = a[1]*b[2] - a[2]*b[1];
  o[1] = a[2]*b[0] - a[0]*b[2];
  o[2] = a[0]*b[1] - a[1]*b[0];
}

