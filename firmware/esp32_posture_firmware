/* --------------------------- calibration FSM ---------------------------- */
enum CalPhase { CAL_IDLE, CAL_SETTLE, CAL_UP, CAL_MOVE, CAL_SLOUCH };
CalPhase calPhase = CAL_IDLE;
uint32_t calPhaseStart = 0, calStart = 0;
double   accUp[3] = {0,0,0}, accSl[3] = {0,0,0};
double   biasAcc[3] = {0,0,0};
uint32_t nUp = 0, nSl = 0, nBias = 0;

const uint32_t T_SETTLE = 5000, T_UP = 25000, T_MOVE = 5000, T_SLOUCH = 25000;

void saveCal();
void loadCal();

void startCalibration() {
  calPhase = CAL_SETTLE;
  calStart = calPhaseStart = millis();
  accUp[0]=accUp[1]=accUp[2]=0; accSl[0]=accSl[1]=accSl[2]=0;
  biasAcc[0]=biasAcc[1]=biasAcc[2]=0;
  nUp = nSl = nBias = 0;
  hintMsg = "";
  hintIsError = false;
  Serial.println("[cal] started (remote trigger)");
}

void finishCalibration() {
  calPhase = CAL_IDLE;
  if (nUp < 200 || nSl < 200) { hintMsg = "Calibration failed: not enough samples. Try again."; hintIsError = true; return; }

  float gu[3] = {(float)(accUp[0]/nUp), (float)(accUp[1]/nUp), (float)(accUp[2]/nUp)};
  float gs[3] = {(float)(accSl[0]/nSl), (float)(accSl[1]/nSl), (float)(accSl[2]/nSl)};
  norm3(gu); norm3(gs);

  memcpy(upRef, gu, sizeof(upRef));

  float d[3] = {gs[0]-gu[0], gs[1]-gu[1], gs[2]-gu[2]};
  float p = dot3(d, upRef);
  float f[3] = {d[0]-p*upRef[0], d[1]-p*upRef[1], d[2]-p*upRef[2]};
  float fm = sqrtf(dot3(f,f));
  if (fm < 0.05f) {
    hintMsg = "Calibration failed: your two postures were nearly identical. Slouch harder in phase 2.";
    hintIsError = true;
    return;
  }
  norm3(f); memcpy(fwdRef, f, sizeof(fwdRef));
  cross3(upRef, fwdRef, latRef); norm3(latRef);

  slouchRefAng = atan2f(dot3(gs, fwdRef), dot3(gs, upRef)) * RAD_TO_DEG;
  if (slouchRefAng < 4.0f) {
    hintMsg = "Calibration failed: only " + String(slouchRefAng,1) + " deg between postures. Exaggerate the slouch.";
    hintIsError = true;
    return;
  }
  thrBase = 0.45f * slouchRefAng;
  hyst    = fmaxf(2.0f, 0.20f * slouchRefAng);
  calibrated = true;

  gHat[0]=upRef[0]; gHat[1]=upRef[1]; gHat[2]=upRef[2];
  leanSmooth = latSmooth = 0;
  slouching = false; poseSince = millis();
  curSlouchStart = 0;
  resetSession();
  saveCal();
  hintMsg = "Calibrated. Your slouch measured " + String(slouchRefAng,1) +
            " deg; the line is set at " + String(thrBase,1) + " deg.";
  hintIsError = false;
  Serial.println("[cal] " + hintMsg);
}

void saveCal() {
  prefs.begin("posture", false);
  prefs.putBytes("up",  upRef,  sizeof(upRef));
  prefs.putBytes("fwd", fwdRef, sizeof(fwdRef));
  prefs.putFloat("thr", thrBase);
  prefs.putFloat("hys", hyst);
  prefs.putFloat("ref", slouchRefAng);
  prefs.putBool("cal", calibrated);
  prefs.end();
}
void loadCal() {
  prefs.begin("posture", true);
  calibrated = prefs.getBool("cal", false);
  if (calibrated) {
    prefs.getBytes("up",  upRef,  sizeof(upRef));
    prefs.getBytes("fwd", fwdRef, sizeof(fwdRef));
    thrBase      = prefs.getFloat("thr", 12.0f);
    hyst         = prefs.getFloat("hys", 3.0f);
    slouchRefAng = prefs.getFloat("ref", 25.0f);
    cross3(upRef, fwdRef, latRef); norm3(latRef);
    memcpy(gHat, upRef, sizeof(gHat));
  }
  prefs.end();
}

// Re-zero upright without redoing the full calibration - use after the
// strap shifts. Keeps the learned forward axis and threshold.
void reZeroUpright() {
  if (!calibrated) return;
  memcpy(upRef, gHat, sizeof(upRef));
  float p = dot3(fwdRef, upRef);
  for (int i = 0; i < 3; i++) fwdRef[i] -= p * upRef[i];
  norm3(fwdRef);
  cross3(upRef, fwdRef, latRef); norm3(latRef);
  leanSmooth = latSmooth = 0;
  saveCal();
  hintMsg = "Upright re-zeroed to your current position.";
  hintIsError = false;
  Serial.println("[zero] " + hintMsg);
}

