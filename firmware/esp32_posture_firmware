// Blocking, but only ever called for a single explicit connection attempt
// (either at boot with saved creds, or right after the setup form is submitted).
bool tryConnectSTA(const String &ssid, const String &pass, uint32_t timeoutMs) {
  WiFi.begin(ssid.c_str(), pass.c_str());
  uint32_t t0 = millis();
  while (WiFi.status() != WL_CONNECTED && millis() - t0 < timeoutMs) delay(300);
  return WiFi.status() == WL_CONNECTED;
}

