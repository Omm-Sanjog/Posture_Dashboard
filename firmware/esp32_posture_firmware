void handleProvScan() {
  int n = WiFi.scanNetworks();
  String json = "[";
  for (int i = 0; i < n; i++) {
    if (i > 0) json += ",";
    json += "\"" + WiFi.SSID(i) + "\"";
  }
  json += "]";
  provServer.send(200, "application/json", json);
}

void handleProvSave() {
  String ssid = provServer.hasArg("ssid") ? provServer.arg("ssid") : "";
  String pass = provServer.hasArg("pass") ? provServer.arg("pass") : "";
  if (ssid.length() == 0) {
    provServer.send(200, "text/html", htmlPage("Spine Monitor setup",
      "<h1 class='err'>No network selected</h1><p class='sub'>Go back and choose or type a network name.</p>"));
    return;
  }

  saveWifiCreds(ssid, pass);
  bool ok = tryConnectSTA(ssid, pass, 15000);

  if (ok) {
    String body =
      "<h1 class='ok'>Connected!</h1>"
      "<p class='sub'>This device is now on your Wi-Fi. Paste the key below into the dashboard's \"Add device\" form.</p>"
      "<div class='key'>" + deviceKey + "</div>"
      "<p class='sub'>You can close this page - the device's own setup Wi-Fi network will turn off in a few seconds.</p>";
    provServer.send(200, "text/html", htmlPage("Connected", body));
    provServer.handleClient(); // make sure the response actually goes out before we tear the AP down
    delay(400);
    provisioningActive = false; // loop() will drop the AP and continue into normal operation
  } else {
    String body =
      "<h1 class='err'>Couldn't connect</h1>"
      "<p class='sub'>Check the network name and password and try again.</p>"
      "<form method='GET' action='/'><button type='submit'>Back</button></form>";
    provServer.send(200, "text/html", htmlPage("Connection failed", body));
  }
}

void startProvisioning() {
  char suffix[5];
  snprintf(suffix, sizeof(suffix), "%04X", (unsigned)(esp_random() & 0xFFFF));
  apSSID = "PostureSetup-" + String(suffix);

  WiFi.mode(WIFI_AP);
  WiFi.softAP(apSSID.c_str(), SETUP_AP_PASS);
  delay(200);
  dnsServer.start(53, "*", WiFi.softAPIP()); // answer every DNS query with our own IP -> most phones auto-open the setup page

  provServer.on("/", handleProvRoot);
  provServer.on("/scan", handleProvScan);
  provServer.on("/save", HTTP_POST, handleProvSave);
  provServer.onNotFound([]() {
    provServer.sendHeader("Location", "http://" + WiFi.softAPIP().toString() + "/", true);
    provServer.send(302, "text/plain", "");
  });
  provServer.begin();
  provisioningActive = true;

  Serial.println("=========================================================");
  Serial.println("Not connected to Wi-Fi. Setup mode is on.");
  Serial.println("On your phone, connect to Wi-Fi network: " + apSSID);
  Serial.println("Password: " + String(SETUP_AP_PASS));
  Serial.println("A setup page should open automatically. If not, visit http://192.168.4.1");
  Serial.println("=========================================================");
}

void stopProvisioning() {
  dnsServer.stop();
  provServer.stop();
  WiFi.softAPdisconnect(true);
  WiFi.mode(WIFI_STA);
  provisioningActive = false;
}

/* ------------------------------- vibration -------------------------------- */
void startVibePattern(const uint16_t *seq, uint8_t len) {
  vibeSeq = seq; vibeSeqLen = len; vibeSeqIdx = 0;
  vibeStepStart = millis();
  vibeActive = true;
  digitalWrite(VIBE_PIN, VIBE_ON);
}
void setVibeHold(bool on) {
  if (on == vibeHold) return;
  vibeHold = on;
  if (on) { vibeActive = false; digitalWrite(VIBE_PIN, VIBE_ON); }
  else    { digitalWrite(VIBE_PIN, !VIBE_ON); }
}
void updateVibe(uint32_t now) {
  if (vibeHold) return;
  if (!vibeActive) return;
  if (now - vibeStepStart >= vibeSeq[vibeSeqIdx]) {
    vibeSeqIdx++;
    vibeStepStart = now;
    if (vibeSeqIdx >= vibeSeqLen) { digitalWrite(VIBE_PIN, !VIBE_ON); vibeActive = false; return; }
    digitalWrite(VIBE_PIN, (vibeSeqIdx % 2 == 0) ? VIBE_ON : !VIBE_ON);
  }
}

void readBattery() {
  uint32_t accMv = 0;
  const uint8_t N = 8;
  for (uint8_t i = 0; i < N; i++) accMv += analogReadMilliVolts(BATT_PIN);
  float vAdc  = (accMv / (float)N) / 1000.0f;
  float vBatt = vAdc * BATT_DIVIDER;

  static bool first = true;
  if (first) { battVoltage = vBatt; first = false; }
  else       battVoltage += (vBatt - battVoltage) * 0.25f;

  float pct = 100.0f * (battVoltage - BATT_EMPTY_V) / (BATT_FULL_V - BATT_EMPTY_V);
  battPercent = (int)constrain(pct, 0.0f, 100.0f);
  battLow  = battVoltage <= BATT_LOW_V;
  battCrit = battVoltage <= BATT_CRIT_V;
  battDead = battVoltage <= BATT_DEAD_V;

  if (vibeAlertOn && !vibeHold) {
    if (battCrit && !battWarnedCrit) { startVibePattern(VIBE_PAT_LOWBATT, 3); battWarnedCrit = true; battWarnedLow = true; }
    else if (battLow && !battWarnedLow) { startVibePattern(VIBE_PAT_LOWBATT, 3); battWarnedLow = true; }
  }
  if (!battLow) { battWarnedLow = false; battWarnedCrit = false; }

  uint32_t now = millis();
  if (vibeAlertOn && !vibeHold && battDead &&
      (!lastDeadVibe || now - lastDeadVibe >= BATT_DEAD_REPEAT_MS)) {
    startVibePattern(VIBE_PAT_DEAD, 7);
    lastDeadVibe = now;
  } else if (!battDead) {
    lastDeadVibe = 0;
  }
}

/* ---------------------------- sensor update ----------------------------- */
void updateSensors(float dt) {
  float a[3], g[3];
  if (!mpuRead(a, g, &tempC)) { sensorOK = false; return; }
  sensorOK = true;

  float af[3] = { medA[0].push(a[0]), medA[1].push(a[1]), medA[2].push(a[2]) };

  float w[3] = { g[0]-gBias[0], g[1]-gBias[1], g[2]-gBias[2] };
  float wmag = sqrtf(w[0]*w[0] + w[1]*w[1] + w[2]*w[2]);
  float amag = sqrtf(af[0]*af[0] + af[1]*af[1] + af[2]*af[2]);
  if (wmag < 1.5f && fabsf(amag - 1.0f) < 0.05f)
    for (int i = 0; i < 3; i++) gBias[i] += 0.001f * (g[i] - gBias[i]);

  float wx = w[0]*DEG_TO_RAD, wy = w[1]*DEG_TO_RAD, wz = w[2]*DEG_TO_RAD;
  float d0 = -(wy*gHat[2] - wz*gHat[1]);
  float d1 = -(wz*gHat[0] - wx*gHat[2]);
  float d2 = -(wx*gHat[1] - wy*gHat[0]);
  gHat[0] += d0*dt; gHat[1] += d1*dt; gHat[2] += d2*dt;
  norm3(gHat);

  if (amag > 0.85f && amag < 1.15f) {
    float k = dt / (TAU_COMP + dt);
    for (int i = 0; i < 3; i++) gHat[i] = gHat[i]*(1-k) + (af[i]/amag)*k;
    norm3(gHat);
  }

  float km = dt / (TAU_MOTION + dt);
  motionLvl += (wmag - motionLvl) * km;
  moving = motionLvl > MOVE_DPS;

  float u = dot3(gHat, upRef), f = dot3(gHat, fwdRef), l = dot3(gHat, latRef);
  leanRaw = atan2f(f, u) * RAD_TO_DEG;
  latRaw  = atan2f(l, u) * RAD_TO_DEG;

  float kp = dt / (TAU_POSTURE + dt);
  leanSmooth += (leanRaw - leanSmooth) * kp;
  latSmooth  += (latRaw  - latSmooth)  * kp;

  uint32_t inPhase = millis() - calPhaseStart;
  if (calPhase == CAL_SETTLE) { for (int i = 0; i < 3; i++) biasAcc[i] += g[i]; nBias++; }
  else if (calPhase == CAL_UP && inPhase > 5000)     { for (int i = 0; i < 3; i++) accUp[i] += af[i]; nUp++; }
  else if (calPhase == CAL_SLOUCH && inPhase > 5000) { for (int i = 0; i < 3; i++) accSl[i] += af[i]; nSl++; }
}

/* --------------------------- posture verdict ---------------------------- */
void updatePosture(uint32_t now, uint32_t dtMs) {
  if (!calibrated || calPhase != CAL_IDLE) return;

  float thr = thrBase + userOff;
  bool over  = leanSmooth > thr + hyst * 0.5f;
  bool under = leanSmooth < thr - hyst * 0.5f;

  if (!moving) {
    if (!slouching && over) {
      if (!poseSince) poseSince = now;
      if (now - poseSince >= ENTER_MS) { slouching = true; slouchEvents++; curSlouchStart = now; poseSince = 0; }
    } else if (slouching && under) {
      if (!poseSince) poseSince = now;
      if (now - poseSince >= EXIT_MS) {
        uint32_t len = now - curSlouchStart;
        if (len > longestSlouch) longestSlouch = len;
        slouching = false; poseSince = 0;
      }
    } else poseSince = 0;

    if (slouching) msSlouch += dtMs; else msGood += dtMs;
  }

  bool wantHold = vibeAlertOn && slouching && !moving && curSlouchStart &&
                  (now - curSlouchStart >= slouchVibeMs);
  if (wantHold != vibeHold) setVibeHold(wantHold);
}

/* --------------------------- cloud check-in ------------------------------ */
static String jsonEscape(const String &s) {
  String out; out.reserve(s.length() + 8);
  for (size_t i = 0; i < s.length(); i++) {
    char c = s[i];
    if (c == '"' || c == '\\') out += '\\';
    out += c;
  }
  return out;
}

// Tiny helpers to read our own known, flat JSON response shape - no
// external JSON library needed since the fields/types are fixed.
static bool jsonGetBool(const String &s, const char *key, bool def) {
  String k = String("\"") + key + "\":";
  int i = s.indexOf(k);
  if (i < 0) return def;
  i += k.length();
  return s.startsWith("true", i);
}
static float jsonGetNum(const String &s, const char *key, float def) {
  String k = String("\"") + key + "\":";
  int i = s.indexOf(k);
  if (i < 0) return def;
  i += k.length();
  int j = i;
  while (j < (int)s.length() && (isDigit(s[j]) || s[j]=='-' || s[j]=='.')) j++;
  if (j == i) return def;
  return s.substring(i, j).toFloat();
}

// Sends full telemetry + status, applies any config/commands the dashboard
// set since the last check-in, and returns whether a calibration was
// requested (the caller starts it, since that also needs calPhase==CAL_IDLE).
bool cloudCheckin() {
  if (WiFi.status() != WL_CONNECTED) return false;

  bool calActive = (calPhase != CAL_IDLE);
  int  remain = 0;
  if (calActive) {
    long left = 60000L - (long)(millis() - calStart);
    remain = left > 0 ? (left + 999) / 1000 : 0;
  }
  const char *phaseStr = "idle", *titleStr = "", *msgStr = "";
  switch (calPhase) {
    case CAL_SETTLE: phaseStr="settle"; titleStr="Hold still"; msgStr="Sit comfortably and stay still while the gyro settles."; break;
    case CAL_UP:     phaseStr="upright"; titleStr="Sit tall"; msgStr="Your best upright posture. Chest open, head stacked over hips."; break;
    case CAL_MOVE:   phaseStr="switch"; titleStr="Now slouch"; msgStr="Round your upper back forward, the way you catch yourself sitting."; break;
    case CAL_SLOUCH: phaseStr="slouch"; titleStr="Hold the slouch"; msgStr="Stay slouched. This is the posture you want to be warned about."; break;
    default: break;
  }

  // Sensor failure always takes priority as the visible status, without
  // permanently overwriting hintMsg (which also carries calibration results).
  String outMsg = hintMsg;
  bool   outIsError = hintIsError;
  if (!sensorOK) { outMsg = "Sensor read failed - check MPU6050 wiring/power."; outIsError = true; }

  char body[1300];
  snprintf(body, sizeof(body),
    "{\"p_device_key\":\"%s\",\"p_lean\":%.2f,\"p_lat\":%.2f,\"p_thr\":%.2f,"
    "\"p_slouching\":%s,\"p_moving\":%s,\"p_sensor_ok\":%s,\"p_rssi\":%d,"
    "\"p_battery_pct\":%d,\"p_battery_v\":%.2f,"
    "\"p_good_ms\":%lu,\"p_slouch_ms\":%lu,\"p_slouch_events\":%lu,"
    "\"p_longest_slouch_ms\":%lu,\"p_sess_ms\":%lu,"
    "\"p_calibrated\":%s,\"p_cal_active\":%s,\"p_cal_phase\":\"%s\","
    "\"p_cal_title\":\"%s\",\"p_cal_msg\":\"%s\",\"p_cal_remain\":%d,"
    "\"p_status_msg\":\"%s\",\"p_status_level\":\"%s\"}",
    deviceKey.c_str(), leanSmooth, latSmooth, thrBase + userOff,
    (slouching && !moving) ? "true" : "false", moving ? "true" : "false", sensorOK ? "true" : "false",
    (int)WiFi.RSSI(),
    battPercent, battVoltage,
    (unsigned long)msGood, (unsigned long)msSlouch, (unsigned long)slouchEvents,
    (unsigned long)longestSlouch, (unsigned long)(millis() - sessStart),
    calibrated ? "true" : "false", calActive ? "true" : "false", phaseStr,
    titleStr, msgStr, remain,
    jsonEscape(outMsg).c_str(), outIsError ? "error" : "info");

  WiFiClientSecure client;
  client.setInsecure(); // simplest option for a personal project; see README for caveats
  HTTPClient https;
  String url = String(SUPABASE_URL) + "/rest/v1/rpc/device_checkin";
  if (!https.begin(client, url)) return false;
  https.addHeader("Content-Type", "application/json");
  https.addHeader("apikey", SUPABASE_ANON_KEY);
  https.addHeader("Authorization", String("Bearer ") + SUPABASE_ANON_KEY);

  int code = https.POST((uint8_t*)body, strlen(body));
  bool pendingCal = false;
  if (code == 200) {
    String resp = https.getString();

    pendingCal = jsonGetBool(resp, "calibrate", false);
    if (jsonGetBool(resp, "zero", false))      reZeroUpright();
    if (jsonGetBool(resp, "reset", false))     resetSession();
    if (jsonGetBool(resp, "vibe_test", false)) startVibePattern(VIBE_PAT_CHECK, 1);

    userOff      = jsonGetNum(resp, "sens_offset", userOff);
    vibeAlertOn  = jsonGetBool(resp, "vibe_alert_on", vibeAlertOn);
    float durS   = jsonGetNum(resp, "vibe_dur_s", slouchVibeMs / 1000.0f);
    slouchVibeMs = (uint32_t)(durS * 1000.0f);
  } else {
    Serial.printf("[cloud] check-in failed, HTTP %d\n", code);
  }
  https.end();
  return pendingCal;
}

/* -------------------------------- setup --------------------------------- */
void setup() {
  Serial.begin(115200);
  delay(300);
  pinMode(LED_PIN, OUTPUT);
  digitalWrite(LED_PIN, !LED_ON);
  pinMode(VIBE_PIN, OUTPUT);
  digitalWrite(VIBE_PIN, !VIBE_ON);
  readBattery();

  Wire.begin(I2C_SDA, I2C_SCL);
  Wire.setClock(400000);
  if (!mpuInit()) Serial.println("MPU6050 not found - check SDA/SCL and 3V3.");
  else            Serial.println("MPU6050 ready.");

  loadCal();
  resetSession();

  deviceKey = loadOrCreateDeviceKey();
  Serial.println("Device key: " + deviceKey);

  WiFi.mode(WIFI_STA);
  WiFi.setSleep(false);

  String savedSsid, savedPass;
  bool connected = false;
  if (loadWifiCreds(savedSsid, savedPass)) {
    Serial.println("Trying saved Wi-Fi: " + savedSsid);
    connected = tryConnectSTA(savedSsid, savedPass, WIFI_CONNECT_TIMEOUT_MS);
  }

  if (connected) {
    Serial.println("Wi-Fi connected, IP " + WiFi.localIP().toString());
  } else {
    startProvisioning(); // stays up until handled in loop()
  }

  Serial.println(calibrated
    ? "Loaded saved calibration. Waiting for readings to phone home."
    : "Not calibrated yet - press Calibrate on the dashboard once this device is added.");
}

/* --------------------------------- loop --------------------------------- */
void loop() {
  if (provisioningActive) {
    dnsServer.processNextRequest();
    provServer.handleClient();
    digitalWrite(LED_PIN, ((millis() / 1000) % 2) ? LED_ON : !LED_ON); // slow blink = "needs Wi-Fi setup"
    if (!provisioningActive) stopProvisioning(); // handleProvSave() just succeeded
    return; // nothing else runs until we're actually on Wi-Fi
  }

  static uint32_t nextSample = 0;
  uint32_t nowUs = micros();
  if ((int32_t)(nowUs - nextSample) >= 0) {
    nextSample = nowUs + SAMPLE_US;

    static uint32_t lastMs = 0;
    uint32_t now = millis();
    uint32_t dtMs = lastMs ? now - lastMs : 10;
    if (dtMs > 100) dtMs = 100;
    lastMs = now;
    float dt = dtMs / 1000.0f;

    updateSensors(dt);
    updatePosture(now, dtMs);
    updateVibe(now);

    if (now - lastBattRead >= BATT_READ_MS) { lastBattRead = now; readBattery(); }

    if (calPhase != CAL_IDLE) {
      uint32_t inPhase = now - calPhaseStart;
      digitalWrite(LED_PIN, ((now / 250) % 2) ? LED_ON : !LED_ON);
      if (calPhase == CAL_SETTLE && inPhase >= T_SETTLE) {
        if (nBias > 100) for (int i = 0; i < 3; i++) gBias[i] = biasAcc[i] / nBias;
        calPhase = CAL_UP; calPhaseStart = now;
      } else if (calPhase == CAL_UP && inPhase >= T_UP) {
        calPhase = CAL_MOVE; calPhaseStart = now;
      } else if (calPhase == CAL_MOVE && inPhase >= T_MOVE) {
        calPhase = CAL_SLOUCH; calPhaseStart = now;
      } else if (calPhase == CAL_SLOUCH && inPhase >= T_SLOUCH) {
        finishCalibration();
        digitalWrite(LED_PIN, !LED_ON);
      }
    }
  }

  static uint32_t lastCheckin = 0;
  static uint32_t lastWifiTry = 0;
  uint32_t nowMs = millis();

  if (WiFi.status() != WL_CONNECTED && nowMs - lastWifiTry > 15000) {
    lastWifiTry = nowMs;
    WiFi.reconnect();
  }

  if (nowMs - lastCheckin >= CHECKIN_MS) {
    lastCheckin = nowMs;
    bool calRequested = cloudCheckin();
    if (calRequested && calPhase == CAL_IDLE) startCalibration();
  }
}
